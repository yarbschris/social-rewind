{
  "$schema": "./schema/rule-pack.schema.json",
  "schemaVersion": 1,
  "platform": "instagram",
  "revision": 20,
  "minEngineVersion": 2,
  "startPath": "/",
  "alwaysAllowRoutes": [
    "^/accounts/",
    "^/challenge/",
    "^/two_factor(?:/|$)",
    "^/auth_platform/",
    "^/oauth/",
    "^/legal/",
    "^/privacy/",
    "^/consent/",
    "^/terms/"
  ],
  "features": {
    "blockReels": {
      "title": "Block Reels",
      "description": "Removes the Reels tab and Reels in your feed. A reel someone sends you still opens, but you can't scroll on to more.",
      "group": "content",
      "default": true,
      "rules": {
        "css": [
          "a[href=\"/reels/\"]",
          "a[href^=\"/reels/\"]"
        ],
        "dom": [
          {
            "type": "hideClosest",
            "match": "article a[href*=\"/reel/\"]",
            "closest": "article",
            "when": "html:not([data-sr-path*=\"/reel/\"])",
            "collapse": true
          },
          {
            "type": "hideAllButFirst",
            "selector": "article:has(a[href*=\"/reel/\"])",
            "when": "html[data-sr-path*=\"/reel/\"]"
          },
          {
            "type": "hideAllButFirst",
            "selector": "[role=\"group\"]:has(a[href^=\"/reels/audio/\"])",
            "branch": true,
            "when": "html[data-sr-path^=\"/direct/\"], html[data-sr-path*=\"/reel/\"]"
          }
        ],
        "routes": [
          {
            "pattern": "^/reels(?:/|$)",
            "action": "redirect",
            "to": "/"
          }
        ],
        "network": [
          {
            "url": "^https://www\\.instagram\\.com/(?:graphql/query|api/graphql|api/v1/feed/)",
            "removeWhere": {
              "anyOf": [
                {
                  "path": "product_type",
                  "equals": "clips"
                },
                {
                  "path": "media.product_type",
                  "equals": "clips"
                },
                {
                  "path": "node.media.product_type",
                  "equals": "clips"
                }
              ]
            },
            "verified": false
          }
        ]
      }
    },
    "blockExplore": {
      "title": "Block search posts",
      "description": "Keeps account search but hides the Explore grid and post results.",
      "group": "content",
      "default": true,
      "rules": {
        "css": [
          "html[data-sr-path^=\"/explore\"] a[href*=\"/p/\"]",
          "html[data-sr-path^=\"/explore\"] a[href*=\"/reel/\"]"
        ],
        "routes": [
          {
            "pattern": "^/explore/(?:tags|locations)/",
            "action": "block"
          }
        ]
      }
    },
    "hideComments": {
      "title": "Hide comments",
      "group": "content",
      "default": false,
      "rules": {
        "css": [
          "a[href*=\"/comments/\"]",
          "textarea[aria-label*=\"comment\" i]",
          "form:has(> textarea[aria-label*=\"comment\" i])",
          "svg[aria-label=\"Comment\" i]",
          "span:has(svg[aria-label=\"Comment\" i]) + span[role=\"button\"]"
        ],
        "routes": [
          {
            "pattern": "^/(?:[^/]+/)?p/[^/]+/comments(?:/|$)",
            "action": "block"
          }
        ],
        "dom": [
          {
            "type": "hideClosest",
            "match": "svg[aria-label=\"Comment\" i]",
            "closest": "[role=\"button\"], button"
          }
        ]
      }
    },
    "hideStories": {
      "title": "Hide stories",
      "group": "content",
      "default": false,
      "rules": {
        "css": [
          "div:has(> div[role=\"button\"][aria-label^=\"Story by\"]:nth-child(2))",
          "a[href^=\"/stories/\"]"
        ],
        "routes": [
          {
            "pattern": "^/stories(?:/|$)",
            "action": "redirect",
            "to": "/"
          }
        ],
        "dom": [
          {
            "type": "hideClosest",
            "match": "div:has(> div[role=\"button\"][aria-label^=\"Story by\"]:nth-child(2))",
            "closest": "div",
            "withWrappers": true
          }
        ]
      }
    },
    "hideNotes": {
      "title": "Hide notes",
      "description": "Hides the row of notes at the top of your DMs.",
      "group": "content",
      "default": false,
      "rules": {
        "dom": [
          {
            "type": "hideIfText",
            "container": "div:has(> div[role=\"presentation\"] > div > ul):has(> button)",
            "text": [
              "Your note"
            ],
            "when": "html[data-sr-path^=\"/direct/\"]",
            "withWrappers": true
          },
          {
            "type": "hideIfText",
            "container": "ul",
            "text": [
              "Your note"
            ],
            "when": "html[data-sr-path^=\"/direct/\"]",
            "withWrappers": true
          }
        ]
      }
    },
    "hideThreadsLink": {
      "title": "Hide Threads link",
      "description": "Hides the link to Threads, which would open outside Social Rewind.",
      "group": "content",
      "default": true,
      "rules": {
        "css": [
          "a[href*=\"threads.net\"]",
          "a[href*=\"threads.com\"]"
        ]
      }
    },
    "hideFeed": {
      "title": "Hide feed",
      "description": "Your home feed shows no posts. DMs, profiles and saved posts still work.",
      "group": "content",
      "default": false,
      "rules": {
        "css": [
          "html[data-sr-path=\"/\"] main article"
        ]
      }
    },
    "blockAds": {
      "title": "Block ads",
      "group": "ads",
      "default": true,
      "rules": {
        "dom": [
          {
            "type": "hideIfText",
            "container": "article",
            "text": [
              "Sponsored",
              "Ad"
            ],
            "collapse": true
          }
        ],
        "network": [
          {
            "url": "^https://www\\.instagram\\.com/(?:graphql/query|api/graphql|api/v1/feed/)",
            "removeWhere": {
              "anyOf": [
                {
                  "path": "ad_id",
                  "exists": true
                },
                {
                  "path": "injected",
                  "exists": true
                },
                {
                  "path": "node.ad_id",
                  "exists": true
                },
                {
                  "path": "node.injected",
                  "exists": true
                },
                {
                  "path": "media.ad_id",
                  "exists": true
                }
              ]
            },
            "verified": false
          }
        ]
      }
    },
    "hideSuggested": {
      "title": "Block suggested posts",
      "description": "Hides posts and accounts from people you don't follow.",
      "group": "ads",
      "default": true,
      "rules": {
        "dom": [
          {
            "type": "hideIfText",
            "container": "article",
            "text": [
              "Suggested for you",
              "Suggested posts"
            ],
            "collapse": true
          }
        ],
        "network": [
          {
            "url": "^https://www\\.instagram\\.com/(?:graphql/query|api/graphql|api/v1/feed/)",
            "removeWhere": {
              "anyOf": [
                {
                  "path": "suggested_users",
                  "exists": true
                },
                {
                  "path": "node.suggested_users",
                  "exists": true
                }
              ]
            },
            "verified": false
          }
        ]
      }
    },
    "hideSuggestedAccounts": {
      "title": "Hide suggested accounts",
      "description": "Hides “Suggested for you” people to follow.",
      "group": "ads",
      "default": true,
      "rules": {
        "css": [
          "main div:has(> div > a[href^=\"/explore/people/\"])"
        ],
        "routes": [
          {
            "pattern": "^/explore/people(?:/|$)",
            "action": "redirect",
            "to": "/"
          }
        ]
      }
    },
    "hideReposts": {
      "title": "Hide reposts",
      "group": "ads",
      "default": false,
      "rules": {
        "dom": [
          {
            "type": "hideIfText",
            "container": "article",
            "text": [
              "reposted",
              "Reposted"
            ],
            "collapse": true
          }
        ]
      }
    },
    "hideAiLabeled": {
      "title": "Hide AI-labeled posts",
      "group": "ads",
      "default": false,
      "rules": {
        "dom": [
          {
            "type": "hideIfText",
            "container": "article",
            "text": [
              "AI content",
              "AI info",
              "Made with AI"
            ],
            "collapse": true
          }
        ]
      }
    },
    "hideStoryAds": {
      "title": "Hide story ads",
      "description": "Coming soon: automatically skips sponsored stories.",
      "group": "ads",
      "default": false,
      "available": false,
      "rules": {}
    }
  },
  "modes": {
    "dmsOnly": {
      "title": "DMs only",
      "description": "Only your messages, and posts or reels people send you. Everything else is blocked.",
      "home": "/direct/inbox/",
      "allowRoutes": [
        "^/direct/",
        "^/(?:[^/]+/)?(?:p|reel)/[^/]+/?$"
      ],
      "rules": {
        "css": [
          "a[href=\"/\"]",
          "a[href=\"/explore/\"]",
          "a[href=\"/reels/\"]",
          "a[href=\"/create/select/\"]",
          "a[href*=\"threads.net\"]",
          "a[href*=\"threads.com\"]"
        ],
        "dom": [
          {
            "type": "hideClosest",
            "match": "svg[aria-label=\"Back\" i]",
            "closest": "a, [role=\"button\"], button",
            "when": "html[data-sr-path^=\"/direct/inbox\"]"
          }
        ]
      }
    },
    "savedOnly": {
      "title": "Saved posts only",
      "description": "Only posts you've saved. Everything else is blocked.",
      "home": "/{username}/saved/",
      "allowRoutes": [
        "^/[^/]+/saved(?:/.*)?$",
        "^/(?:[^/]+/)?(?:p|reel)/[^/]+/?$"
      ],
      "rules": {
        "css": [
          "a[href=\"/explore/\"]",
          "a[href=\"/reels/\"]",
          "a[href=\"/direct/inbox/\"]",
          "a[href*=\"threads.net\"]",
          "a[href*=\"threads.com\"]"
        ]
      }
    }
  },
  "counter": {
    "item": "article",
    "key": {
      "selector": "a[href*=\"/p/\"], a[href*=\"/reel/\"]",
      "attr": "href",
      "pattern": "/(?:p|reel)/([^/?#]+)"
    },
    "routes": ["^/(?:[^/]+/)?(?:p|reel)/([^/?#]+)/?$"],
    "minVisibleRatio": 0.5,
    "minVisibleMs": 1000
  },
  "identity": {
    "scope": [
      "a[href=\"/\"]",
      "a[href=\"/direct/inbox/\"]"
    ],
    "selector": "a[href]",
    "attr": "href",
    "pattern": "^/(?!(?:explore|reels|direct|create|accounts|stories|p|reel)/)([A-Za-z0-9._]+)/$"
  }
}

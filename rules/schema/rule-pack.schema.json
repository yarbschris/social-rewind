{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yarbschris/social-rewind/rules/schema/rule-pack.schema.json",
  "title": "Social Rewind rule pack",
  "description": "Declarative filter rules for one platform. Data only: no code, no hosts.",
  "type": "object",
  "required": [
    "schemaVersion",
    "platform",
    "revision",
    "minEngineVersion",
    "startPath",
    "features"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "platform": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "minEngineVersion": {
      "type": "integer",
      "minimum": 1
    },
    "startPath": {
      "$ref": "#/$defs/path"
    },
    "alwaysAllowRoutes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/regex"
      }
    },
    "features": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/feature"
      }
    },
    "modes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?!normal$)[a-z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/mode"
      }
    },
    "counter": {
      "$ref": "#/$defs/counter"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^/(?![/\\\\])(?!.*\\\\)(?!.*://)"
    },
    "regex": {
      "type": "string",
      "minLength": 1
    },
    "selector": {
      "type": "string",
      "minLength": 1
    },
    "feature": {
      "type": "object",
      "required": [
        "title",
        "group",
        "default",
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "group": {
          "enum": [
            "content",
            "ads"
          ]
        },
        "default": {
          "type": "boolean"
        },
        "available": {
          "type": "boolean"
        },
        "rules": {
          "$ref": "#/$defs/ruleSet"
        }
      }
    },
    "mode": {
      "type": "object",
      "required": [
        "title",
        "home",
        "allowRoutes"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "home": {
          "type": "string",
          "pattern": "^/(?![/\\\\])(?!.*\\\\)(?!.*://)"
        },
        "allowRoutes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/regex"
          }
        },
        "rules": {
          "$ref": "#/$defs/ruleSet"
        }
      }
    },
    "ruleSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "css": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selector"
          }
        },
        "dom": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/domRule"
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/routeRule"
          }
        },
        "network": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/networkRule"
          }
        }
      }
    },
    "domRule": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "match",
            "closest"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "hideClosest"
            },
            "match": {
              "$ref": "#/$defs/selector"
            },
            "closest": {
              "$ref": "#/$defs/selector"
            },
            "when": {
              "$ref": "#/$defs/selector"
            },
            "collapse": {
              "type": "boolean"
            },
            "withWrappers": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "container",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "hideIfText"
            },
            "container": {
              "$ref": "#/$defs/selector"
            },
            "text": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "match": {
              "enum": [
                "exact",
                "prefix"
              ]
            },
            "within": {
              "$ref": "#/$defs/selector"
            },
            "when": {
              "$ref": "#/$defs/selector"
            },
            "collapse": {
              "type": "boolean"
            },
            "withWrappers": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "selector"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "hideAllButFirst"
            },
            "selector": {
              "$ref": "#/$defs/selector"
            },
            "when": {
              "$ref": "#/$defs/selector"
            },
            "branch": {
              "type": "boolean"
            },
            "collapse": {
              "type": "boolean"
            },
            "withWrappers": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "match",
            "within"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "hideBranch"
            },
            "match": {
              "$ref": "#/$defs/selector"
            },
            "within": {
              "$ref": "#/$defs/selector"
            },
            "keep": {
              "$ref": "#/$defs/selector"
            },
            "when": {
              "$ref": "#/$defs/selector"
            },
            "collapse": {
              "type": "boolean"
            },
            "withWrappers": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "routeRule": {
      "type": "object",
      "required": [
        "pattern",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "$ref": "#/$defs/regex"
        },
        "action": {
          "enum": [
            "block",
            "redirect"
          ]
        },
        "to": {
          "type": "string",
          "pattern": "^/(?![/\\\\])(?!.*\\\\)(?!.*://)"
        }
      },
      "if": {
        "properties": {
          "action": {
            "const": "redirect"
          }
        }
      },
      "then": {
        "required": [
          "to"
        ],
        "properties": {
          "to": {
            "type": "string"
          }
        }
      }
    },
    "networkRule": {
      "type": "object",
      "required": [
        "url",
        "removeWhere"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "$ref": "#/$defs/regex"
        },
        "removeWhere": {
          "$ref": "#/$defs/predicate"
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "anyOf"
          ],
          "additionalProperties": false,
          "properties": {
            "anyOf": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "allOf"
          ],
          "additionalProperties": false,
          "properties": {
            "allOf": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/predicate"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "path"
          ],
          "additionalProperties": false,
          "minProperties": 2,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "exists": {
              "type": "boolean"
            },
            "equals": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "in": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            }
          }
        }
      ]
    },
    "counter": {
      "type": "object",
      "required": [
        "item",
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "item": {
          "$ref": "#/$defs/selector"
        },
        "key": {
          "type": "object",
          "required": [
            "selector",
            "attr"
          ],
          "additionalProperties": false,
          "properties": {
            "selector": {
              "$ref": "#/$defs/selector"
            },
            "attr": {
              "type": "string"
            },
            "pattern": {
              "$ref": "#/$defs/regex"
            }
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/regex"
          }
        },
        "minVisibleRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "minVisibleMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "selector",
        "attr",
        "pattern"
      ],
      "additionalProperties": false,
      "properties": {
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "attr": {
          "type": "string"
        },
        "pattern": {
          "$ref": "#/$defs/regex"
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/selector"
          }
        }
      }
    }
  }
}
